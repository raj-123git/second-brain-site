---
// Ask.astro — "Talk to my second brain" (public edition), rendered inside the Contact section only
// when the `ask` slot in sections.json is approved. Posts to /api/ask (site/functions/api/ask.js);
// same origin, no third-party code. The intro paragraph is approved queue text; the chrome below
// (label, placeholder, note) is scanned by the leak gate like every other source file.
interface Props { intro: string; email: string }
const { intro, email } = Astro.props;
---
<div class="ask" id="ask">
  <h3 class="ask-title">Talk to my second brain</h3>
  <div class="ask-intro"><Fragment set:html={intro} /></div>
  <form class="ask-form" autocomplete="off">
    <label class="sr-only" for="ask-q">Your question</label>
    <textarea id="ask-q" name="q" rows="2" maxlength="400" placeholder="Ask about a project, a skill, or how I work" required></textarea>
    <button type="submit" class="ask-btn">Ask</button>
  </form>
  <div class="ask-out" aria-live="polite" hidden></div>
  <p class="ask-note">Answers come only from the text on this page. Personal questions and build details get a polite no and my email: <a href={`mailto:${email}`}>{email}</a>.</p>
</div>

<script>
  const root = document.getElementById("ask");
  if (root) {
    const form = root.querySelector("form") as HTMLFormElement;
    const q = root.querySelector("textarea") as HTMLTextAreaElement;
    const out = root.querySelector(".ask-out") as HTMLElement;
    const btn = root.querySelector("button") as HTMLButtonElement;
    const resting = "The assistant is resting right now. Email me instead.";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = q.value.trim();
      if (text.length < 3) return;
      btn.disabled = true;
      out.hidden = false;
      out.textContent = "Thinking…";
      try {
        const r = await fetch("/api/ask", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ q: text }),
        });
        const d = await r.json();
        out.textContent = d.answer || d.error || resting;
        out.classList.toggle("refused", Boolean(d.refused));
      } catch {
        out.textContent = resting;
      }
      btn.disabled = false;
    });
  }
</script>

<style>
  .ask { margin-top: 2rem; padding: 1.25rem 1.25rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); box-shadow: var(--shadow); text-align: left; }
  .ask-title { font-family: var(--serif); font-weight: 500; font-size: var(--t-0); margin: 0 0 .5rem; color: var(--ink); }
  .ask-intro :global(p) { margin: 0 0 .9rem; color: var(--ink-2); font-size: var(--t-sm); }
  .ask-form { display: grid; grid-template-columns: 1fr auto; gap: .6rem; align-items: stretch; }
  .ask-form textarea { font: inherit; font-size: var(--t-sm); color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: .6rem .75rem; resize: vertical; min-height: 2.8rem; }
  .ask-form textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ask-btn { font: inherit; font-size: var(--t-sm); font-weight: 600; color: var(--on-accent); background: var(--accent); border: 0; border-radius: 10px; padding: .6rem 1.1rem; cursor: pointer; }
  .ask-btn:hover { background: var(--accent-strong); }
  .ask-btn:disabled { opacity: .6; cursor: progress; }
  .ask-out { margin-top: .9rem; padding: .8rem .95rem; border-left: 3px solid var(--accent); background: var(--surface-2); border-radius: 0 10px 10px 0; color: var(--ink); font-size: var(--t-sm); line-height: 1.55; white-space: pre-wrap; }
  .ask-out.refused { border-left-color: var(--line-strong); color: var(--ink-2); }
  .ask-note { margin: .8rem 0 0; font-size: var(--t-xs); color: var(--ink-3); }
  .ask-note a { color: var(--accent); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 480px) { .ask-form { grid-template-columns: 1fr; } }
</style>
